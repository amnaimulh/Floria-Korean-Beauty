# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SESSION_SECRET: Secret key used to sign authentication tokens (defaults to ephemeral runtime key if unset).
SESSION_SECRET=

# ADMIN_EMAIL & ADMIN_PASSCODE: Optional initial/override administrator credentials.
# Leave blank to use the built-in first-run Admin Setup flow at /admin/login.
ADMIN_EMAIL=
ADMIN_PASSCODE=

# Optional external PostgreSQL / Supabase configuration for future production migration
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
